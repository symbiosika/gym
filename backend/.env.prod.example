# Production environment for docker-compose.prod.yml (copy to backend/.env.prod).
# Generate secrets with: cd backend && bun run init   (then copy the values)
BASE_URL=https://gym.example.com
APP_NAME=GYM
ALLOWED_ORIGINS=https://gym.example.com

SECRETS_AES_KEY=
SECRETS_AES_IV=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=

# Mail for magic-link login. console.localhost writes mails to logs/email instead.
SMTP_HOST=console.localhost
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_DEFAULT_SENDER=noreply@example.com

# AI: Gemini proposes recording plans from the scene photo and text. Without a
# key the framework provider (AI_PROVIDER) is used; without any provider the
# app falls back to deterministic plans.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Data critics: the service in critics/ that checks every uploaded dataset.
# docker-compose.prod.yml sets CRITICS_URL for the app, so it only needs to be
# set to move the service elsewhere. Set the key when the service is protected
# (the same value goes to the critics container).
# CRITICS_URL=http://critics:8080
# CRITICS_API_KEY=

# Storage of the app's bytes (scene photos, plan images, the chunks of a
# dataset upload). Always stored by the symbiosika-framework; this picks which
# of its backends. "db" needs nothing and puts them in the backup of the
# database; "s3" keeps them out of it and is reached by every replica. The
# datasets themselves are not affected: they live in the data critics service.
# See backend/src/lib/storage.
GYM_STORAGE_DRIVER=db
# With GYM_STORAGE_DRIVER=s3 (S3_ENDPOINT only for anything that is not AWS):
# S3_BUCKET=gym
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=eu-central-1
# S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# S3_PREFIX=gym
# S3_VIRTUAL_HOSTED_STYLE=false
