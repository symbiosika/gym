# App-specific required variables, applied by `bun run init`.
#
# VALUE syntax: {shared_secret} generates a secret; {user_input} prompts;
# {!} forces overwrite; {folder://PATH:SRC} copies from another service's .env.

# Public base URL of the app.
BASE_URL=http://localhost:3000

# Display name, used in login mails and the auth pages.
APP_NAME=Symbiosika Gym

# PGlite (bun run db:local) serialises connections; one pooled connection is
# the safe default for local development. Raise it when running against a real
# Postgres (docker compose).
POSTGRES_CONNECTION_POOL_SIZE=1

# Shared secret for OAuth2 token introspection (RFC 7662). The embedded MCP
# server validates tokens in process; this keeps /oauth/introspect usable for
# external resource servers.
OAUTH_INTROSPECTION_SECRET={shared_secret}

# Wall clock of the cell. Logs carry local time, bag files epoch nanoseconds;
# both are converted in this zone so protocols show the operator's time of day.
GYM_TIMEZONE=Europe/Berlin

# Where the app stores bytes: scene photos, the reference images of a plan and
# the chunks of a dataset upload. The storing itself is always done by the
# symbiosika-framework; this only picks which of its backends. "db" keeps them
# in the database (nothing to set up, they are in the backup of the database),
# "s3" in an S3-compatible object store, "local" on the disc of the container
# (development only; a second replica does not see them).
# See backend/src/lib/storage.
GYM_STORAGE_DRIVER=db

# With GYM_STORAGE_DRIVER=s3, the store the framework writes to. S3_ENDPOINT is
# only needed for anything that is not AWS (MinIO, Ceph, Cloudflare R2, Hetzner,
# Scaleway); S3_PREFIX puts all keys under one path so one bucket can hold
# several installations; S3_VIRTUAL_HOSTED_STYLE=true puts the bucket in the
# host name. Leave the credentials out when the runtime provides them.
# S3_BUCKET=gym
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=eu-central-1
# S3_ENDPOINT=http://minio:9000
# S3_PREFIX=gym
# S3_VIRTUAL_HOSTED_STYLE=false

# How long a link to a dataset that GYM hands the data critics stays good.
# They fetch the archive themselves over the internal network; the framework
# caps this at 24 hours whatever is set here. Default 3600.
# GYM_DATASET_SHARE_TTL_SECONDS=3600
