{
  "name": "symbiosika-gym-backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.2",
    "@electric-sql/pglite-pgvector": "^0.0.3",
    "@electric-sql/pglite-socket": "^0.2.2",
    "@types/bun": "^1.3.3",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/nodemailer": "^6.4.16",
    "@types/pg": "^8.15.5",
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "^0.31.5",
    "prettier": "^3.3.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-sdk/mistral": "^3.0.5",
    "@ai-sdk/openai-compatible": "~2.0.62",
    "@ai-sdk/valibot": "2.0.41",
    "@hono/standard-validator": "^0.1.5",
    "@hono/swagger-ui": "0.5.2",
    "@hono/valibot-validator": "0.5.3",
    "@mozilla/readability": "^0.6.0",
    "@simplewebauthn/server": "^13.0.0",
    "@simplewebauthn/types": "^12.0.0",
    "@valibot/to-json-schema": "^1.5.0",
    "ai": "6.0.230",
    "cron": "4.3.3",
    "csv": "6.4.1",
    "drizzle-orm": "0.44.6",
    "drizzle-valibot": "0.4.2",
    "fflate": "0.8.3",
    "hono": "4.10.1",
    "hono-openapi": "1.1.0",
    "jsonwebtoken": "9.0.2",
    "linkedom": "^0.18.12",
    "nanoid": "5.1.6",
    "nodemailer": "7.0.9",
    "pg": "8.16.3",
    "pgvector": "0.2.1",
    "postgres": "3.4.7",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "valibot": "^1.2.0",
    "yaml": "^2.8.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:local": "bun run ./framework/.scripts/test-local.ts",
    "db:local": "bun run ./framework/.scripts/local-db-server.ts",
    "db:query": "bun run ./framework/.scripts/db-query.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:remove": "docker compose down -v",
    "dev": "bun --hot run src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --minify",
    "app:migrate": "drizzle-kit migrate",
    "app:generate": "drizzle-kit generate",
    "app:studio": "drizzle-kit studio",
    "framework:migrate": "drizzle-kit migrate --config framework/drizzle.config.ts",
    "framework:generate": "drizzle-kit generate --config framework/drizzle.config.ts",
    "generate": "drizzle-kit generate --config framework/drizzle.config.ts && drizzle-kit generate",
    "migrate": "drizzle-kit migrate --config framework/drizzle.config.ts && drizzle-kit migrate",
    "init": "bun run ./framework/.scripts/init.ts",
    "testuser": "bash ./.scripts/testuser.sh",
    "seed:demo": "bun run ./seeds/demo.ts"
  }
}
