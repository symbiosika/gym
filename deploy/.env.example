# Environment for deploy/docker-compose.yml (copy to deploy/.env).
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d
# Generate the crypto values with: cd backend && bun run init

# Where the images come from: ghcr.io/<owner> by default, or your own registry.
IMAGE_PREFIX=ghcr.io/symbiosika

# Which build to run: latest (main), develop (develop) or a commit sha.
IMAGE_TAG=latest

# Public entry. The domain must already resolve to this host, otherwise
# Let's Encrypt cannot issue the certificate on the first start.
APP_DOMAIN=gym.example.com
BASE_URL=https://gym.example.com
ALLOWED_ORIGINS=https://gym.example.com
ACME_EMAIL=

APP_NAME=GYM
GYM_TIMEZONE=Europe/Berlin

POSTGRES_USER=gym
POSTGRES_DB=gym
POSTGRES_PASSWORD=

SECRETS_AES_KEY=
SECRETS_AES_IV=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=

# Mail for magic-link login. console.localhost writes mails to logs/email instead.
SMTP_HOST=console.localhost
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_DEFAULT_SENDER=noreply@example.com

# AI: Gemini proposes recording plans. Without a key the app falls back to
# deterministic plans. The critics use the same key for their VLM checks.
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Shared secret between app and critics; set it on both or on neither.
CRITICS_API_KEY=
# The critics UI is bound to the host's loopback only — reach it with
# ssh -L 8080:127.0.0.1:8080 <host>
CRITICS_PORT=8080
